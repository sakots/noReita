# セッション本体は除外し、HTTPアクセス拒否設定だけを配布する
!noreita/session/
noreita/session/*
!noreita/session/.htaccess

# 非公開ランタイムディレクトリも拒否設定だけを配布する
!noreita/cache/
noreita/cache/*
!noreita/cache/.htaccess
!noreita/backup/
noreita/backup/*
!noreita/backup/.htaccess
!noreita/errorlog/
noreita/errorlog/*
!noreita/errorlog/.htaccess
!noreita/auditlog/
noreita/auditlog/*
!noreita/auditlog/.htaccess

# 一時画像は非公開。Apacheの拒否設定だけを配布する。
!noreita/tmp/
noreita/tmp/*
!noreita/tmp/.htaccess

# v4の既定値config.phpは配布対象。設置者固有設定だけを除外する。
config.local.php

# sassコンパイル用のnode_modulesは除外する。
node_modules/
