<FilesMatch "\.html?$">
  <IfModule mod_headers.c>
    Header set Pragma "no-cache"
    Header set Cache-Control "no-cache"
    Header set Expires "Thu, 01 Dec 1994 16:00:00 GMT"
  </IfModule>
</FilesMatch>

# PHPがmultipart本文を一時ファイルへ展開する前に、リクエスト全体を32MiBで拒否する。
<IfModule mod_core.c>
  LimitRequestBody 33554432
</IfModule>

# 設定、DB、ログ、メタデータをHTTPから保護する。
# SQLiteのWAL・共有メモリ・ロールバックジャーナルも対象に含める。
<FilesMatch "(?i)(^config(?:\.[a-z0-9_-]+)*\.php$|\.(?:ini|log|dat|json|db(?:-(?:wal|shm|journal))?)$)">
  # Apache 2.4以降
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>

  # Apache 2.2および互換サーバー
  <IfModule !mod_authz_core.c>
    Order Allow,Deny
    Deny from all
  </IfModule>
</FilesMatch>
