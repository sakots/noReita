<!DOCTYPE html>
<html lang="ja">

<head>
  <meta charset="utf-8">
  <title>{{ board_title }}</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="theme/{{ theme_dir }}/luminous/luminous-basic.min.css">
  {% include 'components/eda_headCss.twig' %}
  <link rel="stylesheet" href="theme/{{ theme_dir }}/luminous/noreita-luminous.css">
  {% if oya is not empty %}
    {% for bbsline in oya %}
    <meta name="twitter:card" content="summary">
    <meta property="og:title" content="[{{ bbsline['tid'] }}] {{ bbsline['sub'] }} by {{ bbsline['a_name'] }} - {{ board_title }}">
    <meta property="og:type" content="article">
    <meta property="og:url" content="{{ base }}{{ self }}?mode=res&amp;res={{ resno }}">
    {% if bbsline['picfile'] is defined %}
      <meta property="og:image" content="{{ base }}{{ path }}{{ bbsline['picfile'] }}">
    {% endif %}
    <meta property="og:site_name" content="">
    <meta property="og:description" content="{{ bbsline['com'] }}">
    {% endfor %}
  {% endif %}
  {% include 'components/eda_customCss.twig' %}
</head>

<body>
  <header id="header">
    <h1><a href="{{ self }}">{{ board_title }}</a></h1>
    <div>
      <a href="{{ home }}" target="_top">[ホーム]</a>
      {% include 'components/eda_adminSession.twig' %}
    </div>
    <hr>
    <div>
      <section>
        <p class="top menu">
          <a href="{{ self }}">[トップ]</a>
          <a href="#footer">[↓]</a>
        </p>
      </section>
      <section>
        <hr>
        <p>RES MODE</p>
        <p class="sysmsg">{{ message }}</p>
      </section>
    </div>
    <hr>
  </header>
  <main>
    <div class="thread">
      {% if oya is not empty %}
      {% for bbsline in oya %}
      {% if bbsline['com'] is defined %}
      <section>
        <h3 class="oyat">
          <span class="oyano">[{{ bbsline['tid'] }}]</span>
          {{ bbsline['sub'] }}
        </h3>
        <section>
          {% include 'components/eda_threadOyaName.twig' with {'bbsline' : bbsline} %} <!-- スレ主の名前 -->
          {% if bbsline['picfile'] %}
          {% include 'components/eda_threadOyaPicfile.twig' with {'bbsline' : bbsline} %} <!-- スレ主の画像 -->
            {% endif %}
            <div class="item_comment">
              <p class="comment oya">{{ bbsline['com']|raw }}</p>
              {% if ko is not empty %}
                {% for res in ko %}
                  <section class="res">
                  {% include 'components/eda_threadRepName.twig' with {'res' : res} %} <!-- レスの名前 -->
                    {% if res['picfile'] %}
                      {% include 'components/eda_threadRepPicfile.twig' with {'res' : res} %} <!-- レスの画像 -->
                    {% endif %}
                    <p class="comment">{{ res['com']|raw }}</p>
                  </section>
                {% endfor %}
              {% endif %}
            </div>
          </section>
        <hr>
      </section>
      {% if share_button %}
        <div class="thfoot">
          {% include 'components/eda_resThreadFoot.twig' with {'bbsline' : bbsline} %} <!-- スレッドフッタ（SNSシェアボタンなど） -->
        </div>
      {% endif %}
      {% endif %}
      <div>
        {% for bbsline in oya %}
          {% if bbsline['com'] is not empty %}
            <section>
              {% if bbsline['parent'] < 1 %}
                <h3 class="oekaki">このスレにリプライ</h3>
                {% if use_oekaki_reply %}
                  <hr>
                  <section class="epost">
                    {% include 'components/eda_picpostForm.twig' with {'resno' : bbsline['tid']} %} <!-- お絵かき返信フォーム -->
                  </section>
                  <hr>
                {% endif %}
                <script>
                  function add_to_com() {
                    document.getElementById("p_input_com").value += "{{ resname }}さん";
                  }
                </script>
                {% if elapsed_time == 0  or  nowtime - bbsline['past'] < elapsed_time %}
                  <p>
                    <button class="copy_button" onclick="add_to_com()">投稿者名をコピー</button>
                    （投稿者名をコピぺできます）
                  </p>
                  {% include 'components/eda_resForm.twig' with {'resno' : bbsline['tid']} %} <!-- 返信フォーム -->
                {% else %}
                  <p>このスレは古いので返信できません</p>
                {% endif %}
              {% else %}
                <p><a href="{{ self }}?mode=res&amp;res={{ bbsline['parent'] }}">このスレッドへ</a></p>
              {% endif %}
            </section>
          {% endif %}
        {% endfor %}
      </div>
      <div class="thfoot">
        <a href="#header">[↑]</a>
      </div>
    {% endfor %}
  {% else %}
    <section>
      <h3 class="oyat">エラー</h3>
      <h4>none</h4>
      <p>そんなスレッドないです。</p>
    </section>
  {% endif %}
</div>
  </main>
    <footer id="footer">
      {% include 'components/eda_footerCopy.twig' %}
    </footer>
    <!-- scripts -->
    <script src="theme/{{ theme_dir }}/js/sodane.js"></script>
    {% if use_image_upload %}
    <script src="animation-upload.js?v={{ animation_upload_version }}" data-endpoint="{{ self }}?mode=animation_upload"
      data-neo-dir="{{ neo_dir }}" data-tegaki-dir="{{ tegaki_dir }}"
      data-tegaki-enabled="{{ use_tegaki ? '1' : '0' }}"
      data-max-work-bytes="{{ animation_upload_max_bytes }}"
      data-max-width="{{ pmax_w }}" data-max-height="{{ pmax_h }}"></script>
    {% endif %}
    {% include 'components/eda_togglePaletteVisibility.twig' %}
    {% include 'components/eda_luminous.twig' %}
    {% include 'components/eda_snsShare.twig' %}
  </body>
</html>
