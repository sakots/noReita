<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <title>{{ board_title }}</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="theme/{{ theme_dir }}/luminous/luminous-basic.min.css">
  {% include 'components/eda_headCss.twig' %}
  <link rel="stylesheet" href="theme/{{ theme_dir }}/luminous/noreita-luminous.css">
  {% include 'components/eda_customCss.twig' %}
</head>
<body>
  <header id="header">
    <h1><a href="{{ self }}">{{ board_title }}</a></h1>
    <div>
      <section>
        <a href="{{ home }}" target="_top">[ホーム]</a>
        {% include 'components/eda_adminSession.twig' %}
      </section>
    </div>
    <hr>
    <div>
      <section>
        <p class="top menu">
          <a href="{{ self }}?mode=catalog">[カタログ]</a>
          <a href="{{ self }}?mode=pictmp">[投稿途中の絵]</a>
          <a href="#footer">[↓]</a>
        </p>
      </section>
      <section>
        <p class="sysmsg">{{ message ?? '' }}</p> <!-- システムメッセージ -->
      </section>
    </div>
    <hr>
    <div>
      <section class="epost">
        {% include 'components/eda_picpostForm.twig' %} <!-- 絵の投稿フォーム -->
        {% include 'components/eda_info.twig' %} <!-- お知らせ -->
      </section>
      <hr>
      <section class="paging">
        {% include 'components/eda_paging.twig' %} <!-- ページング -->
      </section>
    </div>
  </header>
  <main id="main">
    <div>
      {% if oya is not empty %}
        {% for bbsline in oya %}
          <section class="thread {% if bbsline['will_delete'] %} will-delete-thread {% endif %}">
            {% include 'components/eda_threadTitle.twig' with {'bbsline' : bbsline} %} <!-- スレッドタイトル -->
            {% include 'components/eda_thread.twig' with {'bbsline' : bbsline} %} <!-- スレッド内容 -->
          </section>
        {% endfor %}
      {% endif %}
    </div>
    <div>
      <section class="thread">
        <section class="paging">
          {% include 'components/eda_paging.twig' %} <!-- ページング -->
        </section>
        <hr>
        {% include 'components/eda_searchForm.twig' %} <!-- 検索フォーム -->
        {% include 'components/eda_deleteForm.twig' %} <!-- 削除フォームとcssスイッチ -->
      </section>
    </div>
  </main>
  <footer id="footer">
    {% include 'components/eda_footerCopy.twig' %} <!-- コピーライト -->
  </footer>
  <!-- scripts -->
  <script src="theme/{{ theme_dir }}/js/sodane.js"></script>
  <script src="trip-preview.js?v={{ trip_preview_version }}" data-endpoint="{{ self }}?mode=trip_preview"></script>
  {% include 'components/eda_togglePaletteVisibility.twig' %}
  {% include 'components/eda_luminous.twig' %}
  {% include 'components/eda_snsShare.twig' %}
</html>
